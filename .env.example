# Workflow Studio requires PostgreSQL. These defaults target a local server.
# Create the database and user first, then replace the password.
WORKFLOW_STUDIO_LAUNCH_PROFILE=demo
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=workflow_studio
PGPASSWORD=replace-me
PGDATABASE=workflow_studio
PGSSL_MODE=disable

# Aiven example: replace the local settings above with the service values,
# set PGSSL_MODE=verify-ca, and save the downloaded CA certificate locally.
# PGHOST=your-service.aivencloud.com
# PGPORT=16251
# PGUSER=avnadmin
# PGPASSWORD=replace-me
# PGDATABASE=defaultdb
# PGSSL_MODE=verify-ca
# PGSSL_CA_FILE=./certs/aiven-ca.pem

# DATABASE_URL may replace PGHOST, PGPORT, PGUSER, PGPASSWORD, and PGDATABASE.
# DATABASE_URL=postgresql://user:password@host:5432/database

# New runs use Mastra. Legacy creation is an emergency rollback path and requires
# both variables below; historical legacy runs remain readable without them.
WORKFLOW_STUDIO_RUNTIME_ENGINE=mastra
WORKFLOW_STUDIO_ENABLE_LEGACY_ROLLBACK=false

# Production governance. Bootstrap addresses are comma-separated and receive
# administrator on signup; all other self-service accounts start as builder.
WORKFLOW_STUDIO_ENFORCE_ROLE_GATES=false
WORKFLOW_STUDIO_REQUIRE_SEPARATE_REVIEWER=false
WORKFLOW_STUDIO_BOOTSTRAP_ADMIN_EMAILS=
# Unique immutable identifier for the deployed release/canary.
# WORKFLOW_STUDIO_RELEASE_ID=2026.09.09.1
# Random 32+ character bearer token used only by the monitoring scraper.
# WORKFLOW_STUDIO_METRICS_TOKEN=replace-with-secret-store-value
# Server-side retention schedules.
WORKFLOW_STUDIO_RUN_RETENTION_DAYS=90
WORKFLOW_STUDIO_JOB_RETENTION_DAYS=30
WORKFLOW_STUDIO_CONNECTION_RETENTION_DAYS=30
# Public HTTPS origin used for same-origin mutation validation in deployment.
# WORKFLOW_STUDIO_PUBLIC_ORIGIN=https://workflow-studio.company.example
CODEX_TIMEOUT_MS=300000
# Multi-screen image generation needs a longer execution window than other runtime requests.
CODEX_EXECUTION_TIMEOUT_MS=900000
# Durable continuation requires an always-on Node server. Disable only for controlled rollout/rollback.
# WORKFLOW_STUDIO_COORDINATOR=off
# Local companion worker capacity (the workflow's approved budget still applies, maximum 10).
# WORKFLOW_STUDIO_COMPANION_CONCURRENCY=4

# App Server is the default provider. Set this to cli to force legacy codex exec.
CODEX_PROVIDER=app-server

# Retry provider startup failures through codex exec while App Server is experimental.
CODEX_APP_SERVER_FALLBACK=true

# Local development defaults to direct App Server access. Set this to paired
# to test the same per-user companion flow used by a deployed installation.
# CODEX_RUNTIME_MODE=paired

# Dedicated app folder; global CODEX_HOME is intentionally ignored.
# Set the same path for the web app, runtime login, and companion.
# WORKFLOW_STUDIO_HOME=C:\Users\you\WorkflowStudio

# HTTPS ZIP or company software-portal URL shown in Profile > Local runtime.
# WORKFLOW_STUDIO_COMPANION_DOWNLOAD_URL=https://downloads.example.com/companion.zip
# WORKFLOW_STUDIO_COMPANION_CHECKSUM_URL=https://downloads.example.com/companion.zip.sha256
# WORKFLOW_STUDIO_COMPANION_SIGNATURE_URL=https://downloads.example.com/companion.zip.sig.json
# WORKFLOW_STUDIO_COMPANION_PUBLIC_KEY_URL=https://downloads.example.com/companion.public.pem
# WORKFLOW_STUDIO_COMPANION_SIGNING_KEY_FILE=C:\secure\workflow-studio-companion-ed25519-private.pem
